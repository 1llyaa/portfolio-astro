---
import { Image } from "astro:assets";
import { caseStudies } from "../data/caseStudies";
---

<section id="work" class="section work rule-top">
	<div class="heading">
		<h2>Case studies</h2>
		<span class="spacer"></span>
		<span class="range">2025 - 2026</span>
	</div>

	{
		caseStudies.map((study) => (
			<article class="study" data-reveal>
				<div class:list={["info", { full: !study.image }]}>
					<div class="tagline">
						<span>{study.year}</span>
						<span class="tick" />
						<span class="status">{study.status}</span>
					</div>
					<h3>{study.title}</h3>
					<div class="tags">
						{study.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
					{study.description.map((paragraph, i) => (
						<p class:list={[{ muted: i > 0 }]}>{paragraph}</p>
					))}
					{study.link && (
						<a class="link" href={study.link.href} target="_blank" rel="noopener">
							{study.link.label}
							<span class="arrow" aria-hidden="true">
								↗
							</span>
						</a>
					)}
				</div>
				{study.image && (
					<a class="visual shot" href={study.link?.href} target="_blank" rel="noopener">
						<Image
							src={study.image.src}
							alt={study.image.alt}
							widths={[420, 840]}
							sizes="(max-width: 700px) 92vw, 500px"
						/>
					</a>
				)}
			</article>
		))
	}
</section>

<style>
	.work {
		padding: clamp(36px, 5vw, 64px) 0 0;
	}

	.heading {
		display: flex;
		align-items: baseline;
		gap: 18px;
		flex-wrap: wrap;
		margin-bottom: clamp(28px, 4vw, 48px);
	}

	.heading h2 {
		margin: 0;
		font: 500 12px/1 "IBM Plex Mono", monospace;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink3);
	}

	.spacer {
		flex: 1;
		min-width: 10px;
	}

	.range {
		font: 400 12px/1 "IBM Plex Mono", monospace;
		color: var(--ink3);
	}

	.study {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
		gap: clamp(24px, 4vw, 64px);
		align-items: start;
		padding: clamp(34px, 5vw, 56px) 0;
		border-bottom: 1px solid var(--rule2);
	}

	.study:first-of-type {
		padding-top: 0;
	}

	.study:last-of-type {
		padding-bottom: clamp(40px, 6vw, 72px);
		border-bottom: none;
	}

	.info {
		min-width: 0;
	}

	.info.full p {
		max-width: 64ch;
	}

	.tagline {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 14px;
		font: 500 11.5px/1 "IBM Plex Mono", monospace;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink3);
	}

	.tick {
		width: 18px;
		height: 1px;
		background: var(--rule);
	}

	.status {
		color: var(--accent);
	}

	.info h3 {
		margin: 0 0 14px;
		font-family: "Young Serif", Georgia, serif;
		font-weight: 400;
		font-size: clamp(27px, 4vw, 44px);
		line-height: 1.08;
		letter-spacing: -0.015em;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		margin-bottom: 20px;
	}

	.tag {
		padding: 4px 9px;
		background: var(--wash);
		font: 400 11.5px/1.3 "IBM Plex Mono", monospace;
		color: var(--ink2);
	}

	.info p {
		margin: 0 0 16px;
		font: 400 clamp(16px, 1.9vw, 18px) / 1.65 "IBM Plex Sans", sans-serif;
		text-wrap: pretty;
	}

	.info p:last-of-type {
		margin-bottom: 20px;
	}

	.info p.muted {
		font: 400 15px/1.6 "IBM Plex Sans", sans-serif;
		color: var(--ink2);
	}

	.link {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font: 500 13px/1 "IBM Plex Mono", monospace;
		border-bottom: 1px solid var(--accent);
		padding-bottom: 3px;
	}

	/* Nudges the direction the glyph points. */
	.arrow {
		display: inline-block;
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.link:hover .arrow {
		transform: translate(2px, -2px);
	}

	.visual {
		display: block;
		min-width: 0;
		border: 1px solid var(--rule2);
		transition: border-color 0.3s ease;
	}

	.visual:hover {
		border-color: var(--accent);
	}

	.visual :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
