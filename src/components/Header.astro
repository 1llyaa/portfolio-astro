---
---

<header class="section header rise" style="--i: 0">
	<span class="wordmark">IM — ČESKÉ BUDĚJOVICE</span>
	<span class="spacer"></span>
	<a href="#work">Work</a>
	<a href="#about">About</a>
	<a href="#contact">Contact</a>
	<button id="theme-toggle" aria-label="Toggle theme">☾</button>
</header>

<style>
	.header {
		padding: clamp(20px, 3vw, 34px) 0;
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: wrap;
	}

	.wordmark {
		font: 500 12px/1 "IBM Plex Mono", monospace;
		letter-spacing: 0.14em;
		color: var(--ink2);
	}

	.spacer {
		flex: 1;
		min-width: 10px;
	}

	.header a {
		position: relative;
		padding-bottom: 3px;
		font: 400 14px/1 "IBM Plex Sans", sans-serif;
		color: var(--ink2);
		transition: color 0.3s ease;
	}

	/* Accent underline wipes in from the left. Flat-paper stand-in for the
	   pill fill on the reference site; no background, no radius, no glass. */
	.header a::after {
		content: "";
		position: absolute;
		inset: auto 0 0 0;
		height: 1px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.header a:hover {
		color: var(--accent);
	}

	.header a:hover::after {
		transform: scaleX(1);
	}

	#theme-toggle {
		width: 30px;
		height: 30px;
		border: 1px solid var(--rule);
		border-radius: 50%;
		background: transparent;
		color: var(--ink2);
		cursor: pointer;
		font: 400 11px/1 "IBM Plex Mono", monospace;
		transition:
			color 0.3s ease,
			border-color 0.3s ease,
			transform 0.12s ease;
	}

	#theme-toggle:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	#theme-toggle:active {
		transform: translateY(1px);
	}
</style>

<script>
	const STORAGE_KEY = "im-theme";
	const button = document.getElementById("theme-toggle")!;

	function setGlyph(theme: string) {
		button.textContent = theme === "dark" ? "☀" : "☾";
	}

	setGlyph(document.documentElement.getAttribute("data-theme") ?? "light");

	button.addEventListener("click", () => {
		const current = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
		const next = current === "dark" ? "light" : "dark";
		document.documentElement.setAttribute("data-theme", next);
		localStorage.setItem(STORAGE_KEY, next);
		setGlyph(next);
	});
</script>
